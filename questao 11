<?php

$peso = 70;
$altura = 1.75;

$imc = $peso / ($altura * $altura);

if ($imc < 18.5) {
    echo "IMC: $imc<br>";
    echo "Abaixo do peso";
} else if ($imc < 25) {
    echo "IMC: $imc<br>";
    echo "Peso normal";
} else if ($imc < 30) {
    echo "IMC: $imc<br>";
    echo "Acima do peso";
} else if ($imc < 40) {
    echo "IMC: $imc<br>";
    echo "Obeso";
} else {
    echo "IMC: $imc<br>";
    echo "Obesidade grave";
}

?>
