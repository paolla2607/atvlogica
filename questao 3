<?php

$salario = 1000;

if ($salario <= 280) {
    $percentual = 20;
} else if ($salario <= 700) {
    $percentual = 15;
} else if ($salario <= 1500) {
    $percentual = 10;
} else {
    $percentual = 5;
}

$aumento = $salario * $percentual / 100;
$novoSalario = $salario + $aumento;

echo "Salário anterior: R$ $salario<br>";
echo "Percentual aplicado: $percentual%<br>";
echo "Valor do aumento: R$ $aumento<br>";
echo "Novo salário: R$ $novoSalario";

?>
